    {"type": "text", "id": "cfg_text", "x": 952, "y": 148, "width": 560, "height": 172, "text": "domain: ratelab\ndescriptors:\n  - key: path\n    value: /search\n    rate_limit: {unit: second, requests_per_unit: 1000}\n  - key: api_key\n    rate_limit: {unit: minute, requests_per_unit: 600}", "originalText": "domain: ratelab\ndescriptors:\n  - key: path\n    value: /search\n    rate_limit: {unit: second, requests_per_unit: 1000}\n  - key: api_key\n    rate_limit: {unit: minute, requests_per_unit: 600}", "fontSize": 15, "fontFamily": 3, "strokeColor": "#22c55e", "roughness": 0},

