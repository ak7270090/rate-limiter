    {"type": "text", "id": "cfg_label", "x": 940, "y": 112, "width": 560, "height": 18, "text": "infra/ratelimit-config.yaml", "originalText": "infra/ratelimit-config.yaml", "fontSize": 14, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},
