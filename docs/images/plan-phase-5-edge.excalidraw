    {"type": "text", "id": "title", "x": 20, "y": 20, "width": 900, "height": 35, "text": "Phase 5: reject at the edge first, keep the per-user rules in the app", "originalText": "Phase 5: reject at the edge first, keep the per-user rules in the app", "fontSize": 28, "fontFamily": 3, "strokeColor": "#1e40af", "roughness": 1},
    {"type": "text", "id": "subtitle", "x": 20, "y": 62, "width": 1400, "height": 20, "text": "Envoy asks a shared rate limit service before the request reaches any replica. The app still enforces tiers and daily quotas.", "originalText": "Envoy asks a shared rate limit service before the request reaches any replica. The app still enforces tiers and daily quotas.", "fontSize": 16, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},

