    {"type": "text", "id": "rpc_text", "x": 952, "y": 388, "width": 560, "height": 96, "text": "domain: ratelab\ndescriptors: [path=/search] [api_key=k42]\n-> overall_code: OVER_LIMIT\n   statuses[0].limit_remaining: 0", "originalText": "domain: ratelab\ndescriptors: [path=/search] [api_key=k42]\n-> overall_code: OVER_LIMIT\n   statuses[0].limit_remaining: 0", "fontSize": 15, "fontFamily": 3, "strokeColor": "#22c55e", "roughness": 0},

