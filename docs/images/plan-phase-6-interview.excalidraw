    {"type": "text", "id": "d1_h", "x": 40, "y": 130, "width": 230, "height": 70, "text": "1 requirements\n+ estimates\n5 min", "originalText": "1 requirements\n+ estimates\n5 min", "fontSize": 16, "fontFamily": 3, "strokeColor": "#1e40af", "roughness": 1},
