    {"type": "line", "id": "div_h", "x": 20, "y": 540, "width": 1380, "height": 0, "points": [[0, 0], [1380, 0]], "strokeColor": "#64748b", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 1},

    {"type": "text", "id": "lua_label", "x": 20, "y": 560, "width": 640, "height": 18, "text": "lua/token_bucket.lua (sketch): Redis clock, read, refill, write, expire", "originalText": "lua/token_bucket.lua (sketch): Redis clock, read, refill, write, expire", "fontSize": 14, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},
    {"type": "rectangle", "id": "lua_panel", "x": 16, "y": 584, "width": 650, "height": 220, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "roundness": {"type": 3}},
    {"type": "text", "id": "lua_text", "x": 32, "y": 598, "width": 620, "height": 192, "text": "local t = redis.call('TIME')\nlocal now_ms = t[1] * 1000 + t[2] / 1000\nlocal b = redis.call('HMGET', KEYS[1], 'tokens', 'ts')\nlocal tokens = math.min(capacity,\n    (b[1] or capacity) + (now_ms - (b[2] or now_ms)) * rate)\nlocal allowed = tokens >= cost\nif allowed then tokens = tokens - cost end\nredis.call('HSET', KEYS[1], 'tokens', tokens, 'ts', now_ms)\nredis.call('PEXPIRE', KEYS[1], ttl_ms)", "originalText": "local t = redis.call('TIME')\nlocal now_ms = t[1] * 1000 + t[2] / 1000\nlocal b = redis.call('HMGET', KEYS[1], 'tokens', 'ts')\nlocal tokens = math.min(capacity,\n    (b[1] or capacity) + (now_ms - (b[2] or now_ms)) * rate)\nlocal allowed = tokens >= cost\nif allowed then tokens = tokens - cost end\nredis.call('HSET', KEYS[1], 'tokens', tokens, 'ts', now_ms)\nredis.call('PEXPIRE', KEYS[1], ttl_ms)", "fontSize": 15, "fontFamily": 3, "strokeColor": "#22c55e", "roughness": 0},

