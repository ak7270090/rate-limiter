    {"type": "text", "id": "title", "x": 20, "y": 20, "width": 900, "height": 35, "text": "Phase 3: shared state in Redis, checked and updated in one atomic step", "originalText": "Phase 3: shared state in Redis, checked and updated in one atomic step", "fontSize": 28, "fontFamily": 3, "strokeColor": "#1e40af", "roughness": 1},
