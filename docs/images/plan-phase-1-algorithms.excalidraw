    {"type": "text", "id": "title", "x": 20, "y": 20, "width": 900, "height": 35, "text": "Phase 1: one interface, six algorithms, six shapes of state", "originalText": "Phase 1: one interface, six algorithms, six shapes of state", "fontSize": 28, "fontFamily": 3, "strokeColor": "#1e40af", "roughness": 1},
    {"type": "text", "id": "subtitle", "x": 20, "y": 62, "width": 1300, "height": 20, "text": "Every algorithm answers acquire(key, cost). What it stores per key decides its memory, its accuracy and how it treats bursts.", "originalText": "Every algorithm answers acquire(key, cost). What it stores per key decides its memory, its accuracy and how it treats bursts.", "fontSize": 16, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},

