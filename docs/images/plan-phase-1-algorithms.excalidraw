    {"type": "text", "id": "prop_text", "x": 712, "y": 670, "width": 660, "height": 112, "text": "@given(arrival_gaps=lists(floats(0, 2)))\nasync def test_never_admits_more_than_limit(...):\n    for gap in arrival_gaps:\n        fake_clock.advance(gap)\n        await limiter.acquire(\"k42\")", "originalText": "@given(arrival_gaps=lists(floats(0, 2)))\nasync def test_never_admits_more_than_limit(...):\n    for gap in arrival_gaps:\n        fake_clock.advance(gap)\n        await limiter.acquire(\"k42\")", "fontSize": 15, "fontFamily": 3, "strokeColor": "#22c55e", "roughness": 0}
