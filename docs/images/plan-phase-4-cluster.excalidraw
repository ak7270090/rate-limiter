    {"type": "text", "id": "title", "x": 20, "y": 20, "width": 900, "height": 35, "text": "Phase 4: three shards help many keys, not one hot key", "originalText": "Phase 4: three shards help many keys, not one hot key", "fontSize": 28, "fontFamily": 3, "strokeColor": "#1e40af", "roughness": 1},
    {"type": "text", "id": "subtitle", "x": 20, "y": 62, "width": 1400, "height": 20, "text": "Redis Cluster spreads keys by hash slot. A per-key limit scales with shards; a global limit is one key on one shard until it is split or leased.", "originalText": "Redis Cluster spreads keys by hash slot. A per-key limit scales with shards; a global limit is one key on one shard until it is split or leased.", "fontSize": 16, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},

    {"type": "text", "id": "s1_title", "x": 20, "y": 108, "width": 680, "height": 22, "text": "hash tags keep a script's keys on one shard", "originalText": "hash tags keep a script's keys on one shard", "fontSize": 18, "fontFamily": 3, "strokeColor": "#3b82f6", "roughness": 1},
