    {"type":"text","id":"title","x":30,"y":20,"width":900,"height":35,"text":"Distributed rate limiter: how one request is decided","originalText":"Distributed rate limiter: how one request is decided","fontSize":28,"fontFamily":3,"strokeColor":"#1e40af","roughness":1},
