    {"type":"text","id":"summary","x":30,"y":686,"width":1840,"height":22,"text":"1 the edge sheds floods  ->  2 who is calling, which limit  ->  3 one atomic Lua call in Redis  ->  4 Redis down? the route decides  ->  5 200, or 429 + Retry-After","originalText":"1 the edge sheds floods  ->  2 who is calling, which limit  ->  3 one atomic Lua call in Redis  ->  4 Redis down? the route decides  ->  5 200, or 429 + Retry-After","fontSize":16,"fontFamily":3,"strokeColor":"#1e40af","roughness":1}
