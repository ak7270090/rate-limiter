    {"type":"text","id":"redis_note","x":1000,"y":575,"width":560,"height":72,"text":"the {hash tag} keeps one caller's keys on one primary,\nso per-key limits spread over all three. A global limit\nis one hot key: split it into 10 sub-keys, or lease\n30 tokens per Redis call.","originalText":"the {hash tag} keeps one caller's keys on one primary,\nso per-key limits spread over all three. A global limit\nis one hot key: split it into 10 sub-keys, or lease\n30 tokens per Redis call.","fontSize":14,"fontFamily":3,"strokeColor":"#64748b","roughness":1},

    {"type":"text","id":"call_caption","x":1000,"y":124,"width":420,"height":20,"text":"the one Redis call, for real","originalText":"the one Redis call, for real","fontSize":15,"fontFamily":3,"strokeColor":"#64748b","roughness":1},
    {"type":"rectangle","id":"call_panel","x":1000,"y":150,"width":500,"height":215,"strokeColor":"#1e293b","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":1,"roughness":0,"roundness":{"type":3}},
    {"type":"text","id":"call_code","x":1020,"y":166,"width":460,"height":185,"text":"EVALSHA <token_bucket.lua> 1\n  rl:{orders:key:k42}:token_bucket\n  10 60 1 5     limit window cost burst\n\n-- runs alone inside Redis:\n-- refill, take a token, write, expire\n\n-> {1, 5, 4, 6000, 0, 0}\n   allowed, 4 left, full again in 6 s","originalText":"EVALSHA <token_bucket.lua> 1\n  rl:{orders:key:k42}:token_bucket\n  10 60 1 5     limit window cost burst\n\n-- runs alone inside Redis:\n-- refill, take a token, write, expire\n\n-> {1, 5, 4, 6000, 0, 0}\n   allowed, 4 left, full again in 6 s","fontSize":15,"fontFamily":3,"strokeColor":"#22c55e","roughness":0},

    {"type":"text","id":"reply_caption","x":1540,"y":124,"width":340,"height":20,"text":"6 taps in 1 second: the 6th","originalText":"6 taps in 1 second: the 6th","fontSize":15,"fontFamily":3,"strokeColor":"#64748b","roughness":1},
    {"type":"rectangle","id":"reply_panel","x":1540,"y":150,"width":330,"height":215,"strokeColor":"#1e293b","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":1,"roughness":0,"roundness":{"type":3}},
    {"type":"text","id":"reply_code","x":1560,"y":166,"width":290,"height":185,"text":"HTTP/1.1 429\nRetry-After: 5\nRateLimit-Policy:\n  \"orders\";q=10;w=60\nRateLimit:\n  \"orders\";r=0;t=29\n\n{\"detail\": \"rate limit\n  exceeded\", \"policy\": \"orders\"}","originalText":"HTTP/1.1 429\nRetry-After: 5\nRateLimit-Policy:\n  \"orders\";q=10;w=60\nRateLimit:\n  \"orders\";r=0;t=29\n\n{\"detail\": \"rate limit\n  exceeded\", \"policy\": \"orders\"}","fontSize":15,"fontFamily":3,"strokeColor":"#22c55e","roughness":0},

    {"type":"text","id":"limits_caption","x":1540,"y":432,"width":300,"height":20,"text":"the limits, in policies.yaml","originalText":"the limits, in policies.yaml","fontSize":15,"fontFamily":3,"strokeColor":"#64748b","roughness":1},
    {"type":"rectangle","id":"limits_panel","x":1540,"y":458,"width":330,"height":150,"strokeColor":"#1e293b","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":1,"roughness":0,"roundness":{"type":3}},
    {"type":"text","id":"limits_code","x":1558,"y":474,"width":300,"height":120,"text":"items    100 / 10 s per key\norders   10 / min, burst 5\nsearch   300 / 10 s, everyone\nreports  50 / day per key\n\nfail: allow | 503 | local","originalText":"items    100 / 10 s per key\norders   10 / min, burst 5\nsearch   300 / 10 s, everyone\nreports  50 / day per key\n\nfail: allow | 503 | local","fontSize":15,"fontFamily":3,"strokeColor":"#22c55e","roughness":0},

