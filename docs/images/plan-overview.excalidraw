    {"type": "text", "id": "api_label", "x": 20, "y": 410, "width": 600, "height": 18, "text": "the standard API, identical in 02-05 (limits from policies.yaml)", "originalText": "the standard API, identical in 02-05 (limits from policies.yaml)", "fontSize": 14, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},
    {"type": "rectangle", "id": "api_panel", "x": 16, "y": 434, "width": 690, "height": 140, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "roundness": {"type": 3}},
    {"type": "text", "id": "api_text", "x": 32, "y": 448, "width": 660, "height": 112, "text": "GET  /ping     no limit              baseline latency\nGET  /items    100 / 10 s per key    accuracy\nPOST /orders   10 / 60 s, burst 5    bursts\nGET  /search   1,000 / s global      hot key\nPOST /reports  50 / day per key      quota", "originalText": "GET  /ping     no limit              baseline latency\nGET  /items    100 / 10 s per key    accuracy\nPOST /orders   10 / 60 s, burst 5    bursts\nGET  /search   1,000 / s global      hot key\nPOST /reports  50 / day per key      quota", "fontSize": 15, "fontFamily": 3, "strokeColor": "#22c55e", "roughness": 0},

    {"type": "text", "id": "rej_label", "x": 760, "y": 410, "width": 600, "height": 18, "text": "every rejected request looks the same, whatever enforces it", "originalText": "every rejected request looks the same, whatever enforces it", "fontSize": 14, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},
    {"type": "rectangle", "id": "rej_panel", "x": 756, "y": 434, "width": 754, "height": 140, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "roundness": {"type": 3}},
    {"type": "text", "id": "rej_text", "x": 772, "y": 448, "width": 720, "height": 112, "text": "HTTP/1.1 429 Too Many Requests\nRetry-After: 4\nRateLimit-Policy: \"items\";q=100;w=10\nRateLimit: \"items\";r=0;t=4\nX-Replica-Id: api-2", "originalText": "HTTP/1.1 429 Too Many Requests\nRetry-After: 4\nRateLimit-Policy: \"items\";q=100;w=10\nRateLimit: \"items\";r=0;t=4\nX-Replica-Id: api-2", "fontSize": 15, "fontFamily": 3, "strokeColor": "#22c55e", "roughness": 0}
