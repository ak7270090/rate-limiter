    {"type": "text", "id": "title", "x": 20, "y": 20, "width": 900, "height": 35, "text": "Rate Limiting Lab: one API, six algorithms, four places to enforce", "originalText": "Rate Limiting Lab: one API, six algorithms, four places to enforce", "fontSize": 28, "fontFamily": 3, "strokeColor": "#1e40af", "roughness": 1},
    {"type": "text", "id": "subtitle", "x": 20, "y": 62, "width": 1300, "height": 20, "text": "Every phase answers one question. The same harness measures every HTTP phase: how many requests got through, compared with the limit.", "originalText": "Every phase answers one question. The same harness measures every HTTP phase: how many requests got through, compared with the limit.", "fontSize": 16, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},

