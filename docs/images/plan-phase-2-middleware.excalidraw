    {"type": "text", "id": "title", "x": 20, "y": 20, "width": 900, "height": 35, "text": "Phase 2: middleware works on one replica and triples the limit on three", "originalText": "Phase 2: middleware works on one replica and triples the limit on three", "fontSize": 28, "fontFamily": 3, "strokeColor": "#1e40af", "roughness": 1},
    {"type": "text", "id": "subtitle", "x": 20, "y": 62, "width": 1300, "height": 20, "text": "The limiter state lives in each process's memory, so every replica counts only the requests it happens to receive.", "originalText": "The limiter state lives in each process's memory, so every replica counts only the requests it happens to receive.", "fontSize": 16, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},

