# Main run: 3 replicas, policies.yaml (Lua scripts). Redis is paused for the failover suite.
HARNESS_TARGET_URL=http://localhost:8080
HARNESS_EXPECTED_REPLICA_COUNT=3
HARNESS_SKIPPED_SUITES=[]
HARNESS_EXPECTED_FAILURES=[]
HARNESS_KILL_COMMAND=docker pause ratelab-phase3-redis-1
HARNESS_RESTORE_COMMAND=docker unpause ratelab-phase3-redis-1
HARNESS_FAILOVER_SETTLE_SECONDS=0.5
HARNESS_RESTORE_SETTLE_SECONDS=3
HARNESS_RESULTS_DIR=../03-redis-centralized/results/redis-lua
