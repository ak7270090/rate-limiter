# 3 API replicas on Redis Cluster (compose.yaml + compose.cluster.yaml).
# Node failures are measured with rateharness.outage_timeline, not the pause-based failover suite.
HARNESS_TARGET_URL=http://localhost:8080
HARNESS_EXPECTED_REPLICA_COUNT=3
HARNESS_SKIPPED_SUITES=["failover"]
HARNESS_EXPECTED_FAILURES=[]
HARNESS_RESULTS_DIR=../04-redis-cluster-scaling/results/cluster
