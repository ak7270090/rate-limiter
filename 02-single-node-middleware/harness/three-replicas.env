# Run B: API_REPLICAS=3, policies.yaml. Every replica counts on its own.
HARNESS_TARGET_URL=http://localhost:8080
HARNESS_EXPECTED_REPLICA_COUNT=3
HARNESS_SKIPPED_SUITES=["failover"]
HARNESS_EXPECTED_FAILURES=["accuracy", "concurrency", "global_limit", "boundary_burst", "headers"]
HARNESS_RESULTS_DIR=../02-single-node-middleware/results/three-replicas
