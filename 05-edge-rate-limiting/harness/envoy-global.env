# Envoy x2 + envoyproxy/ratelimit (:8080), API in shadow mode:
# RATELAB_POLICY_OVERRIDES={"*": {"mode": "shadow"}}. The service only has minute units, so the
# limits are 100 per API key and 300 for everyone per minute, counted in fixed windows.
# Envoy sends X-RateLimit-* headers, not the IETF RateLimit fields.
HARNESS_TARGET_URL=http://localhost:8080
HARNESS_EXPECTED_REPLICA_COUNT=3
HARNESS_PER_KEY_WINDOW_SECONDS=60
HARNESS_GLOBAL_WINDOW_SECONDS=60
HARNESS_SKIPPED_SUITES=["failover", "headers"]
HARNESS_EXPECTED_FAILURES=["boundary_burst"]
HARNESS_RESULTS_DIR=../05-edge-rate-limiting/results/envoy-global
