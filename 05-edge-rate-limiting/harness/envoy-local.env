# Envoy x2 local token bucket on /search (:8084), 300 per 10 s inside each Envoy; API in shadow
# mode. Only the global limit applies here.
HARNESS_TARGET_URL=http://localhost:8084
HARNESS_EXPECTED_REPLICA_COUNT=3
HARNESS_SKIPPED_SUITES=["failover", "headers", "accuracy", "boundary_burst", "concurrency", "latency_overhead"]
HARNESS_EXPECTED_FAILURES=["global_limit"]
HARNESS_RESULTS_DIR=../05-edge-rate-limiting/results/envoy-local
