# nginx limit_req x2 (:8081, EDGE_NGINX_REPLICAS=2), API in shadow mode. Each nginx counts
# only the requests it receives. nginx sends no rate limit headers.
HARNESS_TARGET_URL=http://localhost:8081
HARNESS_EXPECTED_REPLICA_COUNT=3
HARNESS_SKIPPED_SUITES=["failover", "headers"]
HARNESS_EXPECTED_FAILURES=["accuracy", "boundary_burst", "concurrency", "global_limit"]
HARNESS_RESULTS_DIR=../05-edge-rate-limiting/results/nginx-edge-2
