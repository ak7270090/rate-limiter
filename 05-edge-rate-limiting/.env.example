RATELAB_PORT=8000
RATELAB_LOG_LEVEL=info
RATELAB_POLICIES_FILE=policies.yaml
RATELAB_POLICY_OVERRIDES={}
RATELAB_TRUSTED_PROXY_NETWORKS=["127.0.0.1/32", "172.16.0.0/12"]
RATELAB_ALLOW_LISTED_API_KEYS=[]
RATELAB_REDIS_URL=redis://localhost:6379/0
RATELAB_REDIS_TIMEOUT_SECONDS=0.05
RATELAB_REDIS_CONNECT_TIMEOUT_SECONDS=0.25
RATELAB_REDIS_MAX_CONNECTIONS=200
RATELAB_BREAKER_FAILURE_THRESHOLD=3
RATELAB_BREAKER_OPEN_SECONDS=2
